source "https://rubygems.org"

# Avoid ffi 1.17+ which requires Ruby 3+ on some platforms.
gem "ffi", "~> 1.15.5"

# Jekyll 3.9 works with Ruby 2.6+; GitHub Pages builds with a compatible stack.
gem "jekyll", "~> 3.9"
gem "jekyll-seo-tag", "~> 2.8"
gem "jekyll-feed", "~> 0.15"
gem "kramdown-parser-gfm"
